# Copy to signing.env (gitignored) and customize.
# Used by scripts/setup_android_signing.sh — passwords belong here or in env vars.

# Keystore path relative to repo root, or absolute.
ANDROID_KEYSTORE_PATH=android/app/upload-keystore.jks

# Key alias inside the keystore.
ANDROID_KEY_ALIAS=upload

# Passwords (leave empty to be prompted interactively).
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=

# keytool options
ANDROID_KEY_VALIDITY_DAYS=10000
ANDROID_KEY_ALG=RSA
ANDROID_KEY_SIZE=2048

# Distinguished name for the certificate (keytool -dname).
ANDROID_DNAME=CN=Where To Fly, OU=Mobile, O=Where To Fly, L=Buenos Aires, ST=CABA, C=AR
