# Copy to .env beside docker-compose.yml (never commit .env).

# --- PostgreSQL (internal) ---
POSTGRES_USER=dondevolar
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_DB=dondevolar
DATABASE_URL=postgresql://dondevolar:generate-a-long-random-password@postgres:5432/dondevolar

# --- API (production fail-fast for weak secrets) ---
APP_ENV=production
JWT_SECRET=generate-a-long-random-secret
# Listen port inside the container and on the host (change if 9080 is taken).
API_PORT=9080
PORT=9080

# Optional: OpenAIP airspace during zone ingest cron
OPENAIP_API_KEY=

# OAuth (optional)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# --- MinIO (internal; same values as MINIO_ROOT_* in compose) ---
MINIO_ACCESS_KEY=generate-minio-access-key
MINIO_SECRET_KEY=generate-minio-secret-key
MINIO_BUCKET=media

# --- Nginx Proxy Manager ---
# Copy docker-compose.override.example.yml → docker-compose.override.yml and set
# your NPM Docker network. In NPM UI: Forward Host dondevolar-api, Port 9080.
#
# Only if NPM cannot use a shared network (not recommended):
# API_BIND=0.0.0.0
